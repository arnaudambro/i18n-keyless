# Real-life setup: get an API key at https://i18n-keyless.com and copy this to `.env.local`.
# Server reads I18N_KEYLESS_API_KEY; client reads NEXT_PUBLIC_I18N_KEYLESS_API_KEY (set both).
# Leave empty to run offline against examples/_mock-server.
I18N_KEYLESS_API_KEY=
NEXT_PUBLIC_I18N_KEYLESS_API_KEY=
