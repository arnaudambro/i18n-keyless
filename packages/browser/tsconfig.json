{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "baseUrl": "."
  },
  "include": ["./**/*"],
  "exclude": ["node_modules", "__tests__", "vitest.config.ts", "coverage", "dist"]
}
