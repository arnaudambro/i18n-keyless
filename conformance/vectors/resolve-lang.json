{
  "description": "resolveLang(tag, { supported, fallback }): maps a BCP-47 style tag onto a supported language code, most specific first. Normalisation: `_` becomes `-`, the tag is trimmed and lowercased. Candidates in order: (1) the whole tag matched case-insensitively against the 48 codes; (2) if the language subtag is `zh`: the script from the LAST subtag (cn, sg, hans -> zh-Hans; tw, hk, mo, hant -> zh-Hant; anything else -> zh-Hans) and STOP; (3) `es-419` adds `es-MX`; (4) the bare language subtag. The first candidate present in `supported` (when given) wins, else `fallback`, else null. `expected: null` means no language (undefined in TypeScript).",
  "source": "packages/core/types.ts: resolveLang(tag, options)",
  "cases": [
    { "name": "exact code", "input": { "tag": "fr" }, "expected": "fr" },
    { "name": "exact variant", "input": { "tag": "pt-BR" }, "expected": "pt-BR" },
    { "name": "exact en-GB", "input": { "tag": "en-GB" }, "expected": "en-GB" },
    { "name": "region without a variant falls back to the bare language", "input": { "tag": "pt-AO" }, "expected": "pt" },
    { "name": "fr-CH", "input": { "tag": "fr-CH" }, "expected": "fr" },
    { "name": "fr-BE", "input": { "tag": "fr-BE" }, "expected": "fr" },
    { "name": "en-AU", "input": { "tag": "en-AU" }, "expected": "en" },
    { "name": "en-US", "input": { "tag": "en-US" }, "expected": "en" },
    { "name": "de-AT", "input": { "tag": "de-AT" }, "expected": "de" },
    { "name": "es-ES", "input": { "tag": "es-ES" }, "expected": "es" },
    { "name": "es-MX exact", "input": { "tag": "es-MX" }, "expected": "es-MX" },
    { "name": "es-419 is Latin America", "input": { "tag": "es-419" }, "expected": "es-MX" },
    { "name": "es-419 when only es is shipped", "input": { "tag": "es-419", "supported": ["es"] }, "expected": "es" },
    { "name": "zh-TW", "input": { "tag": "zh-TW" }, "expected": "zh-Hant" },
    { "name": "zh-HK", "input": { "tag": "zh-HK" }, "expected": "zh-Hant" },
    { "name": "zh-MO", "input": { "tag": "zh-MO" }, "expected": "zh-Hant" },
    { "name": "zh-Hant exact", "input": { "tag": "zh-Hant" }, "expected": "zh-Hant" },
    { "name": "zh-CN", "input": { "tag": "zh-CN" }, "expected": "zh-Hans" },
    { "name": "zh-SG", "input": { "tag": "zh-SG" }, "expected": "zh-Hans" },
    { "name": "bare zh is Simplified", "input": { "tag": "zh" }, "expected": "zh-Hans" },
    { "name": "zh-Hans-CN", "input": { "tag": "zh-Hans-CN" }, "expected": "zh-Hans" },
    { "name": "zh-Hant-HK", "input": { "tag": "zh-Hant-HK" }, "expected": "zh-Hant" },
    { "name": "Chinese never falls back to another script", "input": { "tag": "zh-TW", "supported": ["zh-Hans", "en"], "fallback": "en" }, "expected": "en" },
    { "name": "underscore separator", "input": { "tag": "zh_CN" }, "expected": "zh-Hans" },
    { "name": "underscore variant", "input": { "tag": "pt_BR" }, "expected": "pt-BR" },
    { "name": "any casing", "input": { "tag": "PT-br" }, "expected": "pt-BR" },
    { "name": "upper case bare", "input": { "tag": "FR" }, "expected": "fr" },
    { "name": "lower case en-gb", "input": { "tag": "en-gb" }, "expected": "en-GB" },
    { "name": "surrounding whitespace is trimmed", "input": { "tag": "  fr  " }, "expected": "fr" },
    { "name": "v2 code cn is not a tag", "input": { "tag": "cn" }, "expected": null },
    { "name": "v2 code cz is not a tag", "input": { "tag": "cz" }, "expected": null },
    { "name": "unknown language", "input": { "tag": "xx" }, "expected": null },
    { "name": "Norwegian Bokmal is not mapped onto no", "input": { "tag": "nb" }, "expected": null },
    { "name": "empty tag", "input": { "tag": "" }, "expected": null },
    { "name": "null tag", "input": { "tag": null }, "expected": null },
    { "name": "supported filter: pt-BR device, app ships pt", "input": { "tag": "pt-BR", "supported": ["pt", "en"] }, "expected": "pt" },
    { "name": "supported filter: pt-BR device, app ships both", "input": { "tag": "pt-BR", "supported": ["pt", "pt-BR", "en"] }, "expected": "pt-BR" },
    { "name": "supported filter: fr-CA device, app ships fr", "input": { "tag": "fr-CA", "supported": ["fr"] }, "expected": "fr" },
    { "name": "fallback when nothing matches", "input": { "tag": "ja", "supported": ["pt", "en"], "fallback": "en" }, "expected": "en" },
    { "name": "fallback for an unknown tag", "input": { "tag": "xx", "fallback": "en" }, "expected": "en" },
    { "name": "fallback for a null tag", "input": { "tag": null, "fallback": "en" }, "expected": "en" },
    { "name": "no fallback: null, never a guess", "input": { "tag": "xx" }, "expected": null }
  ]
}
