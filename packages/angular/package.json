{
  "name": "i18n-keyless-angular",
  "private": false,
  "version": "3.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "prepublishOnly": "rm -rf ./dist && ngc -p tsconfig.json && npm run test && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postpublish": "rm -rf ./dist && rm -f *.tgz"
  },
  "dependencies": {
    "i18n-keyless-core": "3.5.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17.1.0",
    "@angular/core": ">=17.1.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@angular/common": "^20.3.29",
    "@angular/compiler": "^20.3.29",
    "@angular/compiler-cli": "^20.3.29",
    "@angular/core": "^20.3.29",
    "@angular/platform-browser": "^20.3.29",
    "@angular/platform-browser-dynamic": "^20.3.29",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^3.1.1",
    "jsdom": "^26.0.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1",
    "zone.js": "^0.15.0"
  }
}
