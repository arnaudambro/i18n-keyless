{
  "description": "The synchronous resolution of one text (the client-side `getTranslation` / `<T>` path). Input: a store snapshot (current language, primary language, the flat translations map, an optional `defaultNamespace`), the key and the options. Expected: the text returned NOW, and the namespaces queued for translate-on-miss (empty array = nothing queued). `forceTemporary` never changes the returned text: its value only travels to the API.",
  "source": "packages/core/service.ts: getTranslationCore(key, store, options) and translateKey(key, store, options)",
  "cases": [
    { "name": "current language is the primary: the key is returned, nothing is queued", "input": { "store": { "currentLanguage": "fr", "primary": "fr", "translations": {} }, "key": "Bonjour" }, "expected": { "text": "Bonjour", "queued": [] } },
    { "name": "hit", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "Bonjour": "Hello" } }, "key": "Bonjour" }, "expected": { "text": "Hello", "queued": [] } },
    { "name": "miss: the key is returned and the default namespace is queued", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "Bonjour" }, "expected": { "text": "Bonjour", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "context hit", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "8 heures__time": "8 AM", "8 heures": "8 hours" } }, "key": "8 heures", "options": { "context": "time" } }, "expected": { "text": "8 AM", "queued": [] } },
    { "name": "no context does not read the contextual entry", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "8 heures__time": "8 AM", "8 heures": "8 hours" } }, "key": "8 heures" }, "expected": { "text": "8 hours", "queued": [] } },
    { "name": "context miss does not fall back to the plain entry", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "8 heures": "8 hours" } }, "key": "8 heures", "options": { "context": "time" } }, "expected": { "text": "8 heures", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "an empty stored translation counts as missing", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "Bonjour": "" } }, "key": "Bonjour" }, "expected": { "text": "Bonjour", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "UGC viewed in its origin language: the key, no lookup, nothing queued", "input": { "store": { "currentLanguage": "es", "primary": "fr", "translations": {} }, "key": "Hola mundo", "options": { "originLanguage": "es" } }, "expected": { "text": "Hola mundo", "queued": [] } },
    { "name": "UGC viewed in the primary language still looks up the map", "input": { "store": { "currentLanguage": "fr", "primary": "fr", "translations": { "Hola mundo": "Bonjour le monde" } }, "key": "Hola mundo", "options": { "originLanguage": "es" } }, "expected": { "text": "Bonjour le monde", "queued": [] } },
    { "name": "UGC viewed in a third language, miss", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "Hola mundo", "options": { "originLanguage": "es" } }, "expected": { "text": "Hola mundo", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "originLanguage equal to the primary is the regular flow", "input": { "store": { "currentLanguage": "fr", "primary": "fr", "translations": {} }, "key": "Bonjour", "options": { "originLanguage": "fr" } }, "expected": { "text": "Bonjour", "queued": [] } },
    { "name": "forceTemporary for the current language re-queues an existing key and still renders the stored value", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "Bonjour": "Hello" } }, "key": "Bonjour", "options": { "forceTemporary": { "en": "Hi there" } } }, "expected": { "text": "Hello", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "forceTemporary for another language does not queue", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "Bonjour": "Hello" } }, "key": "Bonjour", "options": { "forceTemporary": { "es": "Hola" } } }, "expected": { "text": "Hello", "queued": [] } },
    { "name": "forceTemporary in the primary language is ignored by the client path", "input": { "store": { "currentLanguage": "fr", "primary": "fr", "translations": {} }, "key": "Bonjour", "options": { "forceTemporary": { "fr": "Salut" } } }, "expected": { "text": "Bonjour", "queued": [] } },
    { "name": "replace applies to the key on a miss", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "Hello {{name}}", "options": { "replace": { "{{name}}": "Arnaud" } } }, "expected": { "text": "Hello Arnaud", "queued": [{ "namespace": "default", "unpersisted": false }] } },
    { "name": "replace applies to the translation on a hit", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": { "Bonjour {{name}}": "Hello {{name}}" } }, "key": "Bonjour {{name}}", "options": { "replace": { "{{name}}": "Arnaud" } } }, "expected": { "text": "Hello Arnaud", "queued": [] } },
    { "name": "a per-call namespace is the one queued", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "Payer", "options": { "namespace": "checkout" } }, "expected": { "text": "Payer", "queued": [{ "namespace": "checkout", "unpersisted": false }] } },
    { "name": "unpersistedNamespace is remembered with the namespace", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "Hi", "options": { "namespace": "chat-1", "unpersistedNamespace": true } }, "expected": { "text": "Hi", "queued": [{ "namespace": "chat-1", "unpersisted": true }] } },
    { "name": "the config defaultNamespace is used when the call has none", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {}, "defaultNamespace": "app" }, "key": "Bonjour" }, "expected": { "text": "Bonjour", "queued": [{ "namespace": "app", "unpersisted": false }] } },
    { "name": "a per-call namespace overrides the config defaultNamespace", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {}, "defaultNamespace": "app" }, "key": "Bonjour", "options": { "namespace": "checkout" } }, "expected": { "text": "Bonjour", "queued": [{ "namespace": "checkout", "unpersisted": false }] } },
    { "name": "an empty key returns empty and queues nothing", "input": { "store": { "currentLanguage": "en", "primary": "fr", "translations": {} }, "key": "" }, "expected": { "text": "", "queued": [] } }
  ]
}
