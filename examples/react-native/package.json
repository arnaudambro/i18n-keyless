{
  "name": "i18n-keyless-example-react-native",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "test": "jest"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|i18n-keyless-react|i18n-keyless-core|zustand))"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react"
    }
  },
  "dependencies": {
    "i18n-keyless-core": "file:../../packages/core",
    "i18n-keyless-react": "file:../../packages/react",
    "react": "18.3.1",
    "react-native": "0.77.3",
    "react-native-mmkv": "^3.1.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.77.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.0"
  }
}
