# Real-life setup: get an API key at https://i18n-keyless.com and copy this to `.env`.
# The server reads I18N_KEYLESS_API_KEY; the client reads VITE_I18N_KEYLESS_API_KEY.
# Set both to the same key. Leave empty to run offline against examples/_mock-server.
I18N_KEYLESS_API_KEY=
VITE_I18N_KEYLESS_API_KEY=
