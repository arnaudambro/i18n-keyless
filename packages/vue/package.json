{
  "name": "i18n-keyless-vue",
  "private": false,
  "version": "3.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "rm -rf ./dist && tsc --project tsconfig.json && npm run test && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postpublish": "rm -rf ./dist && rm *.tgz"
  },
  "dependencies": {
    "i18n-keyless-core": "3.4.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^3.1.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.11",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1",
    "vue": "^3.5.0"
  }
}
