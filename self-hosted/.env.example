# ---- Required ---------------------------------------------------------------

# Your lifetime licence, from https://i18n-keyless.com/self-hosted (starts with "ik1.").
# Checked offline at boot; the container never calls home.
LICENSE_KEY=

# The model that translates. Any provider the Vercel AI SDK knows: mistral, openai,
# anthropic, google, or openai-compatible (Ollama, Groq…) with AI_BASE_URL.
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
AI_API_KEY=
# AI_BASE_URL=

# ---- Recommended ------------------------------------------------------------

# The URL your browser will use. Sets the session cookie (secure on https) and the OAuth
# issuer for the MCP server. Default: http://localhost:1800
APP_URL=http://localhost:1800

# The port published on the host (the container always listens on 80).
HOST_PORT=1800

# ---- Optional ---------------------------------------------------------------

# JWT secret of the dashboard sessions. Generated on first boot and kept in /storage
# when unset.
# SECRET=

# Postgres instead of SQLite. Default: file:/storage/i18n-keyless.db
# DATABASE_URL=postgresql://user:password@host/i18n_keyless

# Error reports. By default they go to the maintainers (that is how bugs get fixed).
# `off` disables them; your own Sentry DSN redirects them.
# SENTRY_KEY=
